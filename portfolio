<style>
  :root{
    --bg: #0F1210;
    --bg-raised: #161A17;
    --line: #2A2F2B;
    --ink: #EDEFEA;
    --ink-dim: #A7ACA4;
    --ink-faint: #6E736C;
    --signal: #4FE6C0;
    --signal-dim: #2C7C68;
    --amber: #E6B34F;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background: var(--bg);
    color: var(--ink);
    font-family: 'Inter', sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  ::selection{ background: var(--signal); color: #0F1210; }
  a{ color: inherit; text-decoration: none; }
  .wrap{ max-width: 860px; margin: 0 auto; padding: 0 32px; }
  .mono{ font-family: 'JetBrains Mono', monospace; }
  h1,h2,h3{ font-family: 'Space Grotesk', sans-serif; font-weight: 600; letter-spacing: -0.01em; }

  /* ---- nav ---- */
  header{
    position: sticky; top: 0; z-index: 10;
    background: rgba(15,18,16,0.88);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  header .wrap{ display:flex; align-items:center; justify-content:space-between; height: 64px; }
  .brand{ font-family:'Space Grotesk',sans-serif; font-weight:600; font-size: 16px; }
  .brand span{ color: var(--signal); }
  nav ul{ list-style:none; display:flex; gap: 28px; }
  nav a{ font-size: 14px; color: var(--ink-dim); transition: color .15s; }
  nav a:hover{ color: var(--ink); }

  /* ---- hero ---- */
  .hero{ padding: 96px 0 72px; border-bottom: 1px solid var(--line); }
  .status-line{
    display:inline-flex; align-items:center; gap:8px;
    font-size: 13px; color: var(--signal); margin-bottom: 28px;
  }
  .dot{ width:7px; height:7px; border-radius:50%; background: var(--signal); }
  .hero h1{ font-size: 46px; line-height: 1.15; max-width: 620px; }
  .hero .role{ font-size: 20px; color: var(--ink-dim); margin-top: 14px; font-family: 'Space Grotesk', sans-serif; font-weight: 400; }
  .hero p.lede{ margin-top: 22px; max-width: 560px; color: var(--ink-dim); font-size: 16px; }
  .hero-links{ display:flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
  .btn{
    padding: 10px 18px; border: 1px solid var(--line); border-radius: 6px;
    font-size: 14px; color: var(--ink); transition: border-color .15s, color .15s;
  }
  .btn:hover{ border-color: var(--signal); color: var(--signal); }
  .btn.primary{ background: var(--signal); color: #0F1210; border-color: var(--signal); font-weight: 500; }
  .btn.primary:hover{ opacity: .88; color: #0F1210; }

  /* ---- section shell ---- */
  section{ padding: 72px 0; border-bottom: 1px solid var(--line); }
  .eyebrow{ font-family:'JetBrains Mono',monospace; font-size: 13px; color: var(--signal-dim); margin-bottom: 8px; }
  .sec-title{ font-size: 26px; margin-bottom: 36px; }

  /* ---- about ---- */
  .about-grid{ display:grid; grid-template-columns: 1.3fr 1fr; gap: 48px; }
  .about-grid p{ color: var(--ink-dim); font-size: 15.5px; margin-bottom: 14px; max-width: 480px; }
  .fact-list{ border-left: 1px solid var(--line); padding-left: 22px; }
  .fact{ margin-bottom: 20px; }
  .fact .k{ font-size: 12px; color: var(--ink-faint); font-family:'JetBrains Mono',monospace; text-transform: lowercase; }
  .fact .v{ font-size: 15px; margin-top: 3px; }

  /* ---- projects ---- */
  .project{
    border: 1px solid var(--line); border-radius: 10px; padding: 26px 28px;
    margin-bottom: 16px; background: var(--bg-raised);
    transition: border-color .15s;
  }
  .project:hover{ border-color: var(--signal-dim); }
  .project-top{ display:flex; align-items:flex-start; justify-content:space-between; gap: 20px; }
  .project h3{ font-size: 18px; }
  .project-lang{ font-family:'JetBrains Mono',monospace; font-size: 12px; color: var(--ink-faint); white-space: nowrap; margin-top: 4px; }
  .project p{ color: var(--ink-dim); font-size: 14.5px; margin: 10px 0 14px; max-width: 560px; }
  .project-link{ font-size: 13px; color: var(--signal); font-family:'JetBrains Mono',monospace; }
  .project-link:hover{ text-decoration: underline; }
  .featured-tag{
    font-size: 11px; font-family:'JetBrains Mono',monospace; color: var(--amber);
    border: 1px solid var(--amber); border-radius: 4px; padding: 2px 8px; white-space: nowrap;
  }

  /* ---- skills ---- */
  .skill-cols{ display:grid; grid-template-columns: repeat(3,1fr); gap: 32px; }
  .skill-col h4{ font-family:'JetBrains Mono',monospace; font-size: 13px; color: var(--ink-faint); font-weight:400; margin-bottom: 14px; }
  .skill-col ul{ list-style:none; }
  .skill-col li{ font-size: 14.5px; padding: 6px 0; border-bottom: 1px solid var(--line); color: var(--ink-dim); }
  .skill-col li:last-child{ border-bottom: none; }

  /* ---- education / work ---- */
  .timeline-item{ display:grid; grid-template-columns: 130px 1fr; gap: 20px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .timeline-item:last-child{ border-bottom: none; }
  .timeline-item .when{ font-family:'JetBrains Mono',monospace; font-size: 13px; color: var(--signal-dim); }
  .timeline-item h3{ font-size: 16.5px; }
  .timeline-item .org{ color: var(--ink-dim); font-size: 14px; margin-top: 2px; }
  .timeline-item p{ color: var(--ink-dim); font-size: 14px; margin-top: 8px; max-width: 520px; }

  /* ---- contact ---- */
  .contact{ border-bottom: none; padding-bottom: 96px; }
  .contact-grid{ display:flex; gap: 16px; flex-wrap: wrap; margin-top: 28px; }
  .contact-card{
    flex: 1; min-width: 200px; border: 1px solid var(--line); border-radius: 8px;
    padding: 18px 20px; background: var(--bg-raised); transition: border-color .15s;
  }
  .contact-card:hover{ border-color: var(--signal-dim); }
  .contact-card .k{ font-size: 12px; color: var(--ink-faint); font-family:'JetBrains Mono',monospace; }
  .contact-card .v{ font-size: 15px; margin-top: 6px; }

  footer{ padding: 28px 0; }
  footer .wrap{ display:flex; justify-content: space-between; font-size: 13px; color: var(--ink-faint); }

  @media (max-width: 720px){
    .hero h1{ font-size: 32px; }
    .about-grid, .skill-cols{ grid-template-columns: 1fr; }
    .timeline-item{ grid-template-columns: 1fr; }
    nav ul{ gap: 16px; }
    nav a{ font-size: 13px; }
  }

  @keyframes riseIn{ from{ opacity:0; transform: translateY(10px);} to{ opacity:1; transform:none; } }
  .hero > *{ animation: riseIn .6s ease both; }
  .hero .status-line{ animation-delay: 0s; }
  .hero h1{ animation-delay: .07s; }
  .hero .role{ animation-delay: .14s; }
  .hero p.lede{ animation-delay: .21s; }
  .hero-links{ animation-delay: .28s; }
  @media (prefers-reduced-motion: reduce){ .hero > *{ animation: none; } }
</style>
